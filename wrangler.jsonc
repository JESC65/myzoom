// MyZoom · Promoción 81 · Un único Worker con Workers Static Assets.
// Los secretos (CF_API_TOKEN, HOST_SECRET, INVITE_CODE) y las variables del evento
// se definen en el panel de Cloudflare, nunca aquí. Ver docs/DESPLIEGUE.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myzoom",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Conserva las variables definidas en el panel al desplegar (D-001).
  "keep_vars": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El Worker atiende primero toda petición: respaldo 302 en "/", cabeceras de seguridad y la API.
    "run_worker_first": true
  },
  "vars": {
    "MOCK_RTK": "false"
  }
}
